# ─── MODE ────────────────────────────────────────────────
# "individual" = respond to one private contact
# "group"      = respond in a group chat
TARGET_TYPE=individual

# ─── DATABASE ────────────────────────────────────────────
# Each instance needs its own DB file to keep sessions separate
# Default: bot.db
DB_PATH=bot.db

# ─── INDIVIDUAL TARGET ───────────────────────────────────
# Required when TARGET_TYPE=individual
# Any format works (spaces, dashes, + all auto-stripped)
TARGET_PHONE=1-555-123-4567

# ─── GROUP TARGET ────────────────────────────────────────
# Required when TARGET_TYPE=group
# JID takes priority over name if both are set
TARGET_GROUP_JID=
TARGET_GROUP_NAME=My Group Chat
