# Whitelist style: ignore everything, then re-include what we track.
*
!*/
!/.gitignore
!/.gitattributes
!/.env.example
!/Makefile
!/README.md
!/CLAUDE.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/INSTALL_FOR_AGENTS.md
!/.github/**
!/.githooks/**
!/go.mod
!/go.sum
!/main.go
!/internal/**
!/web/**
!/assets/**
!/scripts/**
!/docs/**

# Never commit (even if re-included above)
/data/
/build/
/dist/
*.syso
*.db
*.db-*
*.db.bak*
*.sqlite*
*.argosmodel
*.whl
model.bin
sentencepiece.model
translator/
venv/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
*.jsonl
*.log
*.pem
*.key
*.p12
.env
.env.*
!/.env.example
secrets.json
instance.json
chats.json
personas.json
approvals.json
runtime.json
calendars.json
recaps.json
/WhatsappDoppel.app
/bot
/bot_draft/
whatsapp_contacts.json
target_cache.json
.DS_Store
